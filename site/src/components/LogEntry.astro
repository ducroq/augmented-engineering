---
interface Props {
  date: string;
  title: string;
  tags?: string[];
}
const { date, title, tags = [] } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<article class="log-entry">
  <div class="log-header">
    <a href={`${base}log`} class="back-link">&larr; Log</a>
    <time class="log-date">{date}</time>
    {tags.length > 0 && (
      <div class="log-tags">
        {tags.map(tag => <span class="log-tag">{tag}</span>)}
      </div>
    )}
    <h1>{title}</h1>
  </div>
  <slot />
  <div class="log-nav">
    <a href={`${base}log`}>&larr; Back to log</a>
  </div>
</article>

<style>
  .log-entry {
    max-width: 40rem;
    margin: 0 auto;
  }

  .log-header {
    padding: 2rem 0 1rem;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--text);
  }

  .log-date {
    display: block;
    font-size: 0.85rem;
    color: var(--evidence);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-top: 1rem;
  }

  .log-tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .log-tag {
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', monospace;
    padding: 0.15rem 0.5rem;
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-muted);
  }

  .log-header h1 {
    font-size: 2.2rem;
    line-height: 1.15;
    margin-top: 0.5rem;
  }

  .log-entry :global(h2) {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .log-entry :global(.evidence-box) {
    background: var(--surface-alt);
    border-left: 3px solid var(--evidence);
    border-radius: 0 4px 4px 0;
    padding: 1rem 1.2rem;
    margin: 1.2rem 0;
  }

  .log-entry :global(.evidence-box p) {
    margin: 0;
    font-size: 0.9rem;
  }

  .log-entry :global(.evidence-box strong) {
    color: var(--evidence);
  }

  .log-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .log-nav a {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
