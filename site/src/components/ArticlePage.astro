---
interface Props {
  date: string;
  title: string;
  subtitle: string;
  tags?: string[];
}
const { date, title, subtitle, tags = [] } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<article class="article-page">
  <div class="article-header">
    <a href={`${base}writing`} class="back-link">&larr; Writing</a>
    <time class="article-date">{date}</time>
    {tags.length > 0 && (
      <div class="article-tags">
        {tags.map(tag => <span class="article-tag">{tag}</span>)}
      </div>
    )}
    <h1>{title}</h1>
    <p class="article-subtitle">{subtitle}</p>
  </div>
  <slot />
  <div class="article-nav">
    <a href={`${base}writing`}>&larr; Back to writing</a>
  </div>
</article>

<style>
  .article-page {
    max-width: 40rem;
    margin: 0 auto;
  }

  .article-header {
    padding: 2rem 0 1rem;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--text);
  }

  .article-date {
    display: block;
    font-size: 0.85rem;
    color: var(--evidence);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-top: 1rem;
  }

  .article-tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .article-tag {
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', monospace;
    padding: 0.15rem 0.5rem;
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-muted);
  }

  .article-header h1 {
    font-size: 2.2rem;
    line-height: 1.15;
    margin-top: 0.5rem;
  }

  .article-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  .article-page :global(h2) {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .article-page :global(h3) {
    margin-top: 1.5rem;
  }

  .article-page :global(ul), .article-page :global(ol) {
    margin-top: 0.5rem;
    padding-left: 1.5rem;
  }

  .article-page :global(li) {
    margin-top: 0.3rem;
    font-size: 0.95rem;
  }

  .article-page :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    color: var(--text-secondary);
    margin: 1rem 0;
    font-style: italic;
  }

  .article-page :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  .article-page :global(th),
  .article-page :global(td) {
    text-align: left;
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .article-page :global(th) {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .article-page :global(.evidence-box) {
    background: var(--surface-alt);
    border-left: 3px solid var(--evidence);
    border-radius: 0 4px 4px 0;
    padding: 1rem 1.2rem;
    margin: 1.2rem 0;
  }

  .article-page :global(.evidence-box p) {
    margin: 0;
    font-size: 0.9rem;
  }

  .article-page :global(.evidence-box strong) {
    color: var(--evidence);
  }

  .article-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .article-nav a {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
